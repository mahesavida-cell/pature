
{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "type": "object",
      "description": "Informasi profil pengguna PatureNews.",
      "properties": {
        "id": { "type": "string" },
        "displayName": { "type": "string" },
        "email": { "type": "string", "format": "email" },
        "bio": { "type": "string" },
        "photoURL": { "type": "string", "format": "uri" },
        "role": { "type": "string", "enum": ["reader", "editor", "admin"] },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "displayName", "email", "role"]
    },
    "Bookmark": {
      "title": "Bookmark",
      "type": "object",
      "description": "Berita yang disimpan oleh pengguna.",
      "properties": {
        "postId": { "type": "string" },
        "title": { "type": "string" },
        "category": { "type": "string" },
        "savedAt": { "type": "string", "format": "date-time" }
      }
    },
    "HistoryItem": {
      "title": "HistoryItem",
      "type": "object",
      "description": "Riwayat bacaan pengguna.",
      "properties": {
        "postId": { "type": "string" },
        "title": { "type": "string" },
        "category": { "type": "string" },
        "viewedAt": { "type": "string", "format": "date-time" }
      }
    },
    "Comment": {
      "title": "Comment",
      "type": "object",
      "description": "Komentar pengguna pada berita.",
      "properties": {
        "content": { "type": "string" },
        "authorId": { "type": "string" },
        "authorName": { "type": "string" },
        "createdAt": { "type": "object" },
        "postId": { "type": "string" },
        "parentId": { "type": "string" },
        "likes": { "type": "array", "items": { "type": "string" } }
      }
    }
  },
  "auth": {
    "providers": ["password", "google", "anonymous"]
  },
  "firestore": {
    "/user_profiles/{userId}": {
      "schema": "UserProfile",
      "description": "Profil publik pengguna."
    },
    "/users/{userId}/bookmarks/{postId}": {
      "schema": "Bookmark",
      "description": "Daftar berita yang diarsipkan pengguna."
    },
    "/users/{userId}/history/{postId}": {
      "schema": "HistoryItem",
      "description": "Riwayat berita yang dibaca pengguna."
    },
    "/posts/{postId}/comments/{commentId}": {
      "schema": "Comment",
      "description": "Komentar pada artikel berita."
    }
  }
}
