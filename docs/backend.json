
{
  "entities": {
    "UserProfile": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "UserProfile",
      "type": "object",
      "description": "Represents a user's profile within the InfoFlow application, holding public information and app-specific settings.",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique identifier for the UserProfile entity."
        },
        "authId": {
          "type": "string",
          "description": "Identifier from the external authentication system."
        },
        "displayName": {
          "type": "string",
          "description": "The public name of the user."
        },
        "email": {
          "type": "string",
          "description": "The email address associated with the user.",
          "format": "email"
        },
        "profileImageUrl": {
          "type": "string",
          "description": "URL to the user's profile picture.",
          "format": "uri"
        },
        "bio": {
          "type": "string",
          "description": "A short biographical description provided by the user."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "id",
        "authId",
        "displayName",
        "email",
        "createdAt",
        "updatedAt"
      ]
    },
    "Bookmark": {
      "title": "Bookmark",
      "type": "object",
      "properties": {
        "postId": { "type": "string" },
        "title": { "type": "string" },
        "category": { "type": "string" },
        "savedAt": { "type": "string", "format": "date-time" }
      }
    },
    "History": {
      "title": "History",
      "type": "object",
      "properties": {
        "postId": { "type": "string" },
        "title": { "type": "string" },
        "category": { "type": "string" },
        "viewedAt": { "type": "string", "format": "date-time" }
      }
    }
  },
  "auth": {
    "providers": [
      "password",
      "anonymous",
      "google.com"
    ]
  },
  "firestore": {
    "structure": [
      {
        "path": "/users/{userId}",
        "definition": {
          "entityName": "UserProfile",
          "schema": {
            "$ref": "#/backend/entities/UserProfile"
          },
          "description": "Private user profile information."
        }
      },
      {
        "path": "/users/{userId}/bookmarks/{postId}",
        "definition": {
          "entityName": "Bookmark",
          "schema": {
            "$ref": "#/backend/entities/Bookmark"
          },
          "description": "Saved posts for the user."
        }
      },
      {
        "path": "/users/{userId}/history/{postId}",
        "definition": {
          "entityName": "History",
          "schema": {
            "$ref": "#/backend/entities/History"
          },
          "description": "Reading history for the user."
        }
      }
    ]
  }
}
