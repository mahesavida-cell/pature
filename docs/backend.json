
{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "type": "object",
      "description": "Represents a user's profile within the InfoFlow application.",
      "properties": {
        "id": { "type": "string" },
        "authId": { "type": "string" },
        "displayName": { "type": "string" },
        "email": { "type": "string", "format": "email" },
        "profileImageUrl": { "type": "string", "format": "uri" },
        "bio": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "authId", "displayName", "email", "createdAt", "updatedAt"]
    },
    "Post": {
      "title": "Post",
      "type": "object",
      "properties": {
        "title": { "type": "string" },
        "content": { "type": "string" },
        "category": { "type": "string" },
        "authorId": { "type": "string" },
        "authorName": { "type": "string" },
        "image": { "type": "string" },
        "excerpt": { "type": "string" },
        "readTime": { "type": "string" },
        "imageCaption": { "type": "string" },
        "imageCredit": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      }
    },
    "Comment": {
      "title": "Comment",
      "type": "object",
      "properties": {
        "postId": { "type": "string" },
        "authorId": { "type": "string" },
        "authorName": { "type": "string" },
        "content": { "type": "string" },
        "parentId": { "type": "string" },
        "likes": { "type": "array", "items": { "type": "string" } },
        "createdAt": { "type": "string", "format": "date-time" }
      }
    },
    "Category": {
      "title": "Category",
      "type": "object",
      "description": "Dynamic category for the main navigation menu.",
      "properties": {
        "name": { "type": "string" },
        "slug": { "type": "string" },
        "subCategories": {
          "type": "array",
          "items": { "type": "string" }
        },
        "order": { "type": "number" }
      },
      "required": ["name", "slug", "subCategories", "order"]
    },
    "Bookmark": {
      "title": "Bookmark",
      "type": "object",
      "properties": {
        "postId": { "type": "string" },
        "title": { "type": "string" },
        "category": { "type": "string" },
        "savedAt": { "type": "string", "format": "date-time" }
      }
    },
    "History": {
      "title": "History",
      "type": "object",
      "properties": {
        "postId": { "type": "string" },
        "title": { "type": "string" },
        "category": { "type": "string" },
        "viewedAt": { "type": "string", "format": "date-time" }
      }
    }
  },
  "auth": {
    "providers": ["password", "anonymous", "google.com"]
  },
  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "#/backend/entities/UserProfile" },
      "description": "Private user profile information."
    },
    "/posts/{postId}": {
      "schema": { "$ref": "#/backend/entities/Post" },
      "description": "Main news articles."
    },
    "/posts/{postId}/comments/{commentId}": {
      "schema": { "$ref": "#/backend/entities/Comment" },
      "description": "Comments for a specific post."
    },
    "/categories/{categoryId}": {
      "schema": { "$ref": "#/backend/entities/Category" },
      "description": "Navigation menu categories."
    },
    "/users/{userId}/bookmarks/{postId}": {
      "schema": { "$ref": "#/backend/entities/Bookmark" },
      "description": "Saved posts for the user."
    },
    "/users/{userId}/history/{postId}": {
      "schema": { "$ref": "#/backend/entities/History" },
      "description": "Reading history for the user."
    }
  }
}
