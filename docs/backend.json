{
  "entities": {
    "UserProfile": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "UserProfile",
      "type": "object",
      "description": "Represents a user's profile information within the InfoFlow application.",
      "properties": {
        "id": { "type": "string" },
        "email": { "type": "string", "format": "email" },
        "displayName": { "type": "string" },
        "role": { "type": "string" },
        "bio": { "type": "string" },
        "profileImageUrl": { "type": "string", "format": "uri" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "email", "displayName", "createdAt", "updatedAt"]
    },
    "Bookmark": {
      "title": "Bookmark",
      "type": "object",
      "properties": {
        "postId": { "type": "string" },
        "title": { "type": "string" },
        "category": { "type": "string" },
        "savedAt": { "type": "string", "format": "date-time" }
      }
    },
    "History": {
      "title": "History",
      "type": "object",
      "properties": {
        "postId": { "type": "string" },
        "title": { "type": "string" },
        "category": { "type": "string" },
        "viewedAt": { "type": "string", "format": "date-time" }
      }
    },
    "Comment": {
      "title": "Comment",
      "type": "object",
      "properties": {
        "content": { "type": "string" },
        "authorId": { "type": "string" },
        "authorName": { "type": "string" },
        "createdAt": { "type": "string" },
        "parentId": { "type": "string" },
        "likes": { "type": "array", "items": { "type": "string" } }
      }
    }
  },
  "auth": {
    "providers": ["password", "google", "anonymous"]
  },
  "firestore": {
    "/userProfiles/{userId}": {
      "schema": { "$ref": "#/backend/entities/UserProfile" },
      "description": "Stores individual user profiles."
    },
    "/userProfiles/{userId}/bookmarks/{postId}": {
      "schema": { "$ref": "#/backend/entities/Bookmark" },
      "description": "User's bookmarked posts."
    },
    "/userProfiles/{userId}/history/{postId}": {
      "schema": { "$ref": "#/backend/entities/History" },
      "description": "User's reading history."
    },
    "/posts/{postId}/comments/{commentId}": {
      "schema": { "$ref": "#/backend/entities/Comment" },
      "description": "Comments on a post."
    }
  }
}
